diff --git a/app/lib/authMutationCoordinator.ts b/app/lib/authMutationCoordinator.ts
new file mode 100644
index 0000000..91825d0
--- /dev/null
+++ b/app/lib/authMutationCoordinator.ts
@@ -0,0 +1,58 @@
+// Central coordination of every auth MUTATION (sign-in, sign-up, sign-out) issued by this app.
+//
+// Why: supabase-js does not make a whole sign-in or sign-out atomic. `signOut()` reads the stored
+// session, calls the server, then removes whatever session is stored; `signInWithPassword()` performs
+// its token request outside that lock and saves the new session afterwards. A sign-out that is already
+// in flight can therefore remove a NEWER account's freshly saved session, and a generation counter in
+// the UI cannot cancel a request that has already started.
+//
+// What this guarantees: all mutations issued through this queue run strictly one after another, and a
+// session-scoped sign-out re-reads the stored session inside the queue and does nothing unless it is
+// still the session it was meant to end. What it does NOT cover: a session changed by something other
+// than this app instance (e.g. another browser context sharing storage). The native iOS app is a
+// single web view, so no such second context exists there.
+
+export interface QueueOptions {
+  // A hung task must not block sign-out forever: after this long the next task is allowed to start.
+  releaseAfterMs?: number
+  setTimer?: (fn: () => void, ms: number) => unknown
+  clearTimer?: (handle: unknown) => void
+}
+
+export function createAuthMutationQueue(options: QueueOptions = {}) {
+  const releaseAfterMs = options.releaseAfterMs ?? 20000
+  const setTimer = options.setTimer ?? ((fn, ms) => setTimeout(fn, ms))
+  const clearTimer = options.clearTimer ?? (handle => clearTimeout(handle as ReturnType<typeof setTimeout>))
+  let tail: Promise<unknown> = Promise.resolve()
+
+  function run<T>(task: () => Promise<T>): Promise<T> {
+    const result = tail.then(task, task)
+    tail = new Promise<void>(release => {
+      const handle = setTimer(release, releaseAfterMs)
+      const done = () => { clearTimer(handle); release() }
+      result.then(done, done)
+    })
+    return result
+  }
+
+  return { run }
+}
+
+export interface CoordinatedAuth {
+  getSession: () => Promise<{ data: { session: { user: { id: string } | null } | null }; error: unknown }>
+  signOut: () => Promise<{ error: unknown }>
+}
+
+// Ends the stored session only if it still belongs to `expectedUserId`.
+export function createSessionScopedSignOut(queue: ReturnType<typeof createAuthMutationQueue>, auth: CoordinatedAuth) {
+  return function signOutSession(expectedUserId: string) {
+    return queue.run(async () => {
+      const { data, error } = await auth.getSession()
+      // If the stored session cannot be read, do not guess: leave it (the gate already treats it as signed out).
+      if (error) return { skipped: true, error }
+      if (data.session?.user?.id !== expectedUserId) return { skipped: true, error: null }
+      const result = await auth.signOut()
+      return { skipped: false, error: result.error ?? null }
+    })
+  }
+}
diff --git a/app/lib/authSessionController.ts b/app/lib/authSessionController.ts
new file mode 100644
index 0000000..b68ad67
--- /dev/null
+++ b/app/lib/authSessionController.ts
@@ -0,0 +1,124 @@
+// Framework-free session resolution for AuthGate. It owns every ordering rule that keeps a stale
+// asynchronous result (session restore, profile bootstrap, sign-out) from granting access:
+//  - each trigger (restore, auth event, dispose) takes a new monotonic generation;
+//  - a result is applied only if its generation is still the newest;
+//  - the auth-state callback itself is synchronous and calls no Supabase API — follow-up work is
+//    scheduled outside the callback;
+//  - a different user always passes through "loading" before they can reach "signed_in".
+
+export interface ControllerUser {
+  id: string
+  email?: string | null
+  email_confirmed_at?: string | null
+  app_metadata?: { provider?: string }
+}
+
+export interface ControllerSession<U extends ControllerUser = ControllerUser> {
+  user: U | null
+}
+
+export type ControllerState<U extends ControllerUser = ControllerUser> =
+  | { status: 'loading'; user: null }
+  | { status: 'signed_out'; user: null }
+  | { status: 'signed_in'; user: U }
+  | { status: 'error'; user: null; message: string }
+
+export interface ControllerDeps<U extends ControllerUser> {
+  getSession: () => Promise<{ data: { session: ControllerSession<U> | null }; error: unknown }>
+  ensureProfile: () => Promise<{ error: unknown }>
+  // Must end only the session of `userId` (see authMutationCoordinator); never a newer account's.
+  signOut: (userId: string) => Promise<unknown>
+  isVerifiedUser: (user: U) => boolean
+  subscribe: (callback: (event: string, session: ControllerSession<U> | null) => void) => { unsubscribe: () => void }
+  onState: (state: ControllerState<U>) => void
+  // Defers work out of the auth-state callback. Defaults to setTimeout(0).
+  schedule?: (task: () => void) => void
+}
+
+export function createAuthSessionController<U extends ControllerUser>(deps: ControllerDeps<U>) {
+  const schedule = deps.schedule ?? (task => { setTimeout(task, 0) })
+  let generation = 0
+  let disposed = false
+  let readyUserId: string | null = null
+  let started = false
+  let subscription: { unsubscribe: () => void } | null = null
+
+  const current = (mine: number) => !disposed && mine === generation
+
+  function emit(mine: number, state: ControllerState<U>) {
+    if (current(mine)) deps.onState(state)
+  }
+
+  async function resolve(mine: number, session: ControllerSession<U> | null) {
+    // A scheduled task that was invalidated before it ran (logout, account switch, dispose, newer event)
+    // must do nothing at all: no state change and, above all, no side effect.
+    if (!current(mine)) return
+    const user = session?.user ?? null
+    if (!user) {
+      readyUserId = null
+      emit(mine, { status: 'signed_out', user: null })
+      return
+    }
+    if (!deps.isVerifiedUser(user)) {
+      readyUserId = null
+      emit(mine, { status: 'signed_out', user: null })
+      if (!current(mine)) return
+      try { await deps.signOut(user.id) } catch { /* the state is already signed_out */ }
+      return
+    }
+    if (readyUserId === user.id) {
+      // Same verified user (token refresh / user update): nothing to bootstrap again.
+      emit(mine, { status: 'signed_in', user })
+      return
+    }
+    readyUserId = null
+    emit(mine, { status: 'loading', user: null })
+    if (!current(mine)) return
+    let profileError: unknown
+    try { profileError = (await deps.ensureProfile()).error } catch (error) { profileError = error || new Error('profile') }
+    // The request cannot be cancelled once started; its result is simply never allowed to grant access.
+    if (!current(mine)) return
+    if (profileError) {
+      emit(mine, { status: 'error', user: null, message: 'Unable to prepare your profile.' })
+      return
+    }
+    readyUserId = user.id
+    emit(mine, { status: 'signed_in', user })
+  }
+
+  async function restore() {
+    const mine = ++generation
+    let result: Awaited<ReturnType<ControllerDeps<U>['getSession']>>
+    try { result = await deps.getSession() } catch { result = { data: { session: null }, error: new Error('session') } }
+    if (!current(mine)) return
+    if (result.error) {
+      emit(mine, { status: 'error', user: null, message: 'Unable to restore your session.' })
+      return
+    }
+    await resolve(mine, result.data.session)
+  }
+
+  function start() {
+    if (started || disposed) return
+    started = true
+    // Synchronous on purpose: no await, no Supabase call. Supabase can deadlock when its own
+    // client is awaited inside this callback.
+    subscription = deps.subscribe((_event, session) => {
+      const mine = ++generation
+      const incomingId = session?.user?.id ?? null
+      if (!incomingId) { readyUserId = null; deps.onState({ status: 'signed_out', user: null }) }
+      else if (incomingId !== readyUserId) { readyUserId = null; deps.onState({ status: 'loading', user: null }) }
+      schedule(() => { void resolve(mine, session) })
+    })
+    void restore()
+  }
+
+  function dispose() {
+    disposed = true
+    generation++
+    subscription?.unsubscribe()
+    subscription = null
+  }
+
+  return { start, dispose }
+}
diff --git a/app/lib/emailVerification.ts b/app/lib/emailVerification.ts
new file mode 100644
index 0000000..e36c0b0
--- /dev/null
+++ b/app/lib/emailVerification.ts
@@ -0,0 +1,10 @@
+// Client-side defense in depth only. `email_confirmed_at` is set by Supabase Auth; if the project's
+// "Confirm email" setting is OFF, Supabase marks new addresses confirmed implicitly, so this check
+// does NOT prove inbox ownership. Trusted enforcement is the Supabase Auth "Confirm email" setting
+// (to be verified ON by an authorized operator) plus server-side authorization. OAuth identities
+// (Apple/Google) are verified by their provider and are not held to the email check.
+export function isVerifiedUser(user: { email_confirmed_at?: string | null; app_metadata?: { provider?: string } }) {
+  const provider = user.app_metadata?.provider
+  if (provider && provider !== 'email') return true
+  return Boolean(user.email_confirmed_at)
+}
